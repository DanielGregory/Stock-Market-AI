# Optional: Finnhub API key for sentiment analysis (free tier at finnhub.io)
# Without this, sentiment is set to 0 and models still run fine
FINNHUB_API_KEY=

# Simulated portfolio size in dollars (default: 100000)
PORTFOLIO_SIZE=100000

# Base URL of your portfolio_analyzer deployment, used by export_predictions.py
# to push GRU predictions into its ML prediction cache after a pipeline run.
PORTFOLIO_ANALYZER_URL=http://localhost:8000
